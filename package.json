{
  "name": "gnk-connect",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "packageManager": "npm@10.8.2",
  "workspaces": [
    "apps/api",
    "apps/portal",
    "apps/admin",
    "apps/website",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "dev:local": "node scripts/dev.mjs",
    "build": "turbo run build",
    "build:local": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "eslint apps packages --quiet",
    "db:migrate": "npm run db:migrate -w @gnk/api",
    "db:seed": "npm run db:seed -w @gnk/api",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.3.3",
    "turbo": "^2.11.4",
    "typescript": "~5.8.2",
    "typescript-eslint": "^8.70.1"
  },
  "optionalDependencies": {
    "@esbuild/darwin-arm64": "^0.25.0",
    "@rollup/rollup-darwin-arm64": "^4.0.0",
    "@turbo/darwin-arm64": "^2.11.4"
  }
}

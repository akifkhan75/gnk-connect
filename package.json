{
  "name": "gnk-connect",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "packageManager": "npm@10.8.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "test:coverage": "npx -y c8 --all --src=services/b2b,packages/suppliers,packages/types npm run test:unit",
    "test:unit": "npx -y tsx scripts/test-unit-suite.ts",
    "test:integration": "npx -y tsx scripts/test-api-integration.ts",
    "test:e2e": "npx -y tsx scripts/test-e2e-lifecycle.ts",
    "test:mobile": "npx -y tsx scripts/test-mobile-app.ts"
  },
  "devDependencies": {
    "turbo": "^2.4.4",
    "typescript": "~5.8.2"
  }
}

{
  "name": "gnk-connect",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "packageManager": "npm@10.8.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "test:coverage": "npx -y c8 --all --src=services/b2b,packages/suppliers,packages/types npm run test:unit",
    "test:unit": "npx -y tsx scripts/test-unit-suite.ts",
    "test:integration": "npx -y tsx scripts/test-api-integration.ts",
    "test:e2e": "npx -y tsx scripts/test-e2e-lifecycle.ts",
    "test:mobile": "npx -y tsx scripts/test-mobile-app.ts",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "generate": "turbo run generate",
    "openapi": "turbo run openapi",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.3.3",
    "turbo": "^2.11.4",
    "typescript": "~5.8.2"
  },
  "optionalDependencies": {
    "@esbuild/darwin-arm64": "^0.25.0",
    "@rollup/rollup-darwin-arm64": "^4.0.0",
    "@turbo/darwin-arm64": "^2.11.4"
  }
}

# Copy to .env and fill in. Never commit real values.

# ---------------- Database (PostgreSQL 16) ---------------- #
POSTGRES_USER=gnk_admin
POSTGRES_PASSWORD=change_me
POSTGRES_DB=gnk_connect_db
DATABASE_URL="postgresql://gnk_admin:change_me@localhost:5433/gnk_connect_db?schema=public"

# ---------------- Redis 7 ---------------- #
REDIS_PASSWORD=
REDIS_URL="redis://localhost:6380"

# ---------------- API ---------------- #
NODE_ENV=development
PORT=4000
# At least 32 random characters: `openssl rand -base64 48`
JWT_SECRET=
# Field encryption for CNIC / passport numbers: `echo v1:$(openssl rand -hex 32)`
PII_ENCRYPTION_KEY=
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002
PORTAL_URL=http://localhost:3001
ADMIN_URL=http://localhost:3002
UPLOAD_DIR=./uploads
# Only "mock" is available until AirDesk sandbox credentials are provided.
SUPPLIER_MODE=mock
SUPPLIER_SYNC_INTERVAL_MINUTES=15
# Optional: enables the website chat assistant (kept server-side).
GEMINI_API_KEY=

# ---------------- Seed (npm run db:seed) ---------------- #
# First super admin. If the password is empty a random one is printed once.
SEED_ADMIN_EMAIL=admin@gnkconnect.pk
SEED_ADMIN_PASSWORD=
# Demo partners and staff (non-production only). Random if empty.
SEED_DEMO_PASSWORD=

# ---------------- Frontends (Vite, inlined at build time) ---------------- #
VITE_API_URL=http://localhost:4000/api/v1
VITE_PORTAL_URL=http://localhost:3001

# ---------------- Docker compose (host ports and URLs) ---------------- #
API_PORT=4010
WEBSITE_PORT=3010
PORTAL_PORT=3011
ADMIN_PORT=3012
DOCKER_API_URL=http://localhost:4010/api/v1
DOCKER_PORTAL_URL=http://localhost:3011
DOCKER_ADMIN_URL=http://localhost:3012
DOCKER_CORS_ORIGINS=http://localhost:3010,http://localhost:3011,http://localhost:3012

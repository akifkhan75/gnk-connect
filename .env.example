# ---------------- Database (PostgreSQL 16) ---------------- #
POSTGRES_USER=gnk_admin
POSTGRES_PASSWORD=your_secure_postgres_password_here
POSTGRES_DB=gnk_connect_db
POSTGRES_PORT=5432
DATABASE_URL="postgresql://gnk_admin:your_secure_postgres_password_here@localhost:5432/gnk_connect_db?schema=public"

# ---------------- In-Memory Cache (Redis 7) ---------------- #
REDIS_PORT=6379
REDIS_PASSWORD=your_secure_redis_password_here
REDIS_URL="redis://:your_secure_redis_password_here@localhost:6379"

# ---------------- NestJS Backend API ---------------- #
PORT=4000
NODE_ENV=development
JWT_SECRET=your_32_byte_minimum_secure_jwt_secret_key_here

# ---------------- AirDesk Integration ---------------- #
AIRDESK_API_URL=https://api.airdesk.travel/v2
AIRDESK_API_KEY=test_airdesk_api_key_sandbox
AIRDESK_AGENCY_CODE=GNK_ELITE_01

# ---------------- Frontend Endpoints ---------------- #
VITE_API_URL=http://localhost:4000/api/v1
VITE_GEMINI_API_KEY=

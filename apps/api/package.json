{
  "name": "@gnk/api",
  "version": "1.0.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "dev": "pnpm run build:deps && prisma generate && nest start --watch",
    "build": "pnpm run build:deps && prisma generate && nest build",
    "start": "node dist/apps/api/src/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "NODE_ENV=test jest --coverage --coverageReporters=text-summary --coverageReporters=text",
    "test:coverage": "NODE_ENV=test jest --coverage",
    "db:migrate": "node scripts/with-env.mjs prisma migrate deploy",
    "db:seed": "pnpm run build:deps && node scripts/with-env.mjs ts-node --transpile-only prisma/seed.ts",
    "db:studio": "node scripts/with-env.mjs prisma studio",
    "build:deps": "pnpm --filter @gnk/types --filter @gnk/validation --filter @gnk/suppliers run build"
  },
  "dependencies": {
    "@gnk/suppliers": "*",
    "@gnk/types": "*",
    "@gnk/validation": "*",
    "@nestjs-redis/throttler-storage": "^2.0.1",
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^11.0.0",
    "@nestjs/jwt": "^12.0.2",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/swagger": "^12.0.2",
    "@nestjs/throttler": "^6.7.1",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "pg": "^8.16.3",
    "argon2": "^0.45.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie-parser": "^1.4.7",
    "helmet": "^8.3.0",
    "nestjs-pino": "^5.2.1",
    "pino-http": "^11.0.0",
    "redis": "^6.2.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "uuid": "^14.0.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^12.1.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.3",
    "@types/pg": "^8.15.5",
    "@types/uuid": "^10.0.0",
    "jest": "^30.5.2",
    "jest-util": "^30.5.1",
    "pino-pretty": "^13.1.3",
    "prisma": "^7.10.0",
    "ts-jest": "^29.4.13",
    "ts-node": "^10.9.2",
    "typescript": "~5.8.2"
  },
  "jest": {
    "testEnvironment": "node",
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "setupFiles": [
      "<rootDir>/test/jest.setup.ts"
    ],
    "forceExit": true,
    "collectCoverageFrom": [
      "**/*.ts",
      "!**/*.spec.ts",
      "!**/test/**",
      "!**/*.module.ts",
      "!main.ts"
    ],
    "coverageDirectory": "../coverage",
    "coverageReporters": [
      "text",
      "text-summary",
      "lcov"
    ],
    "coverageThreshold": {
      "global": {
        "statements": 80,
        "lines": 80,
        "functions": 80,
        "branches": 60
      }
    },
    "transform": {
      "^.+\\.ts$": [
        "ts-jest",
        {
          "tsconfig": {
            "isolatedModules": true,
            "esModuleInterop": true,
            "experimentalDecorators": true,
            "emitDecoratorMetadata": true
          }
        }
      ]
    },
    "moduleNameMapper": {
      "^@nestjs/config$": "<rootDir>/test/nestjs-config.stub.ts",
      "^@nestjs/jwt$": "<rootDir>/test/nestjs-jwt.stub.ts",
      "^@gnk/types$": "<rootDir>/../../../packages/types/src/index.ts",
      "^@gnk/validation$": "<rootDir>/../../../packages/validation/src/index.ts",
      "^@gnk/suppliers$": "<rootDir>/../../../packages/suppliers/src/index.ts",
      "^@gnk/ui/format$": "<rootDir>/../../../packages/ui/src/lib/format.ts",
      "^@gnk/api-client$": "<rootDir>/../../../packages/api-client/src/index.ts"
    }
  }
}

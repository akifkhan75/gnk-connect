{
  "name": "@gnk/api",
  "version": "1.0.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "dev": "npm run build:deps && nest start --watch",
    "build": "npm run build:deps && prisma generate && nest build",
    "start": "node dist/apps/api/src/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "jest",
    "db:migrate": "node scripts/with-env.mjs prisma migrate deploy",
    "db:seed": "npm run build:deps && node scripts/with-env.mjs ts-node --transpile-only prisma/seed.ts",
    "db:studio": "node scripts/with-env.mjs prisma studio",
    "build:deps": "npm run build -w @gnk/types -w @gnk/validation -w @gnk/suppliers --prefix ../.."
  },
  "dependencies": {
    "@gnk/suppliers": "*",
    "@gnk/types": "*",
    "@gnk/validation": "*",
    "@nestjs-redis/throttler-storage": "^2.0.1",
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^11.0.0",
    "@nestjs/jwt": "^12.0.2",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/swagger": "^11.0.0",
    "@nestjs/throttler": "^6.7.1",
    "@prisma/client": "^5.22.0",
    "argon2": "^0.45.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cookie-parser": "^1.4.7",
    "helmet": "^8.3.0",
    "nestjs-pino": "^5.2.1",
    "pino-http": "^11.0.0",
    "redis": "^6.2.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "uuid": "^8.3.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.2.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.0.0",
    "@types/uuid": "^10.0.0",
    "jest": "^30.5.2",
    "jest-util": "^30.5.1",
    "pino-pretty": "^13.1.3",
    "prisma": "^5.22.0",
    "ts-jest": "^29.4.13",
    "ts-node": "^10.9.2",
    "typescript": "~5.8.2"
  },
  "prisma": {
    "seed": "ts-node --transpile-only -r tsconfig-paths/register prisma/seed.ts"
  },
  "jest": {
    "testEnvironment": "node",
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.ts$": [
        "ts-jest",
        {
          "tsconfig": {
            "isolatedModules": true,
            "esModuleInterop": true,
            "experimentalDecorators": true,
            "emitDecoratorMetadata": true
          }
        }
      ]
    },
    "moduleNameMapper": {
      "^@gnk/types$": "<rootDir>/../../../packages/types/src/index.ts",
      "^@gnk/validation$": "<rootDir>/../../../packages/validation/src/index.ts",
      "^@gnk/suppliers$": "<rootDir>/../../../packages/suppliers/src/index.ts"
    }
  }
}
